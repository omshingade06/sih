# Vercel Deployment Ignore
# Prevents bloated serverless function bundles (>225MB limit)

# Node modules & temporary files
frontend/node_modules/
node_modules/
**/node_modules/

# Git and IDE configs
.git/
.github/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test suites & fixtures
tests/
backend/tests/
*/tests/
*test*.py

# Python caches, virtual environments & compiled files
.venv/
venv/
ENV/
env/
backend/.venv/
**/__pycache__/
*.py[cod]
*.pyc
*$py.class
*.egg-info/
dist/
build/

# Local database files
*.sqlite
*.sqlite3
*.db
backend/ertmac_nwis.db

# Documentation & large assets
*.md
!README.md
